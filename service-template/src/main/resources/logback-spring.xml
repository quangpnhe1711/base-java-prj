<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console-only logging. Containers write to stdout and the platform ships it to
  Loki; writing files inside a container is a way to lose logs, not to keep them.

  traceId and spanId are in the pattern so a log line can be correlated with a
  trace in Zipkin. Micrometer Tracing puts them in the MDC.
-->
<configuration>
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-},%X{spanId:-}] %-5level %logger{40} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
